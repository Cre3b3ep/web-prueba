<!DOCTYPE html>
<html lang="es-ES" dir="ltr">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>{{ title }}{% if title != "DWB" %} · DWB{% endif %}</title>
	{% if descripcion %}<meta name="description" content="{{ descripcion }}" />{% endif %}
	<meta name="author" content="{{ sitio.autor }}" />
	<meta name="robots" content="{{ 'noindex,follow' if (borrador or noindex) else 'index,follow' }}" />

	<link href="/css/fuentes.css" type="text/css" rel="stylesheet" />
	<link href="/css/style.css" type="text/css" rel="stylesheet" />
	<link rel="icon" type="image/png" href="/img/fav1.png" sizes="64x64" />
</head>

<body>
	<div id="contenedor">
{% include "partials/menu.njk" %}

		{#- anchoCompleto: true → sin .container (páginas con banners de lado a lado) #}
		<main id="contenido"{% if not anchoCompleto %} class="container section"{% endif %}>
			{% if borrador %}<p class="aviso-borrador" role="note">Borrador: esta página no se publica.</p>{% endif %}
{{ content | safe }}
		</main>

{% include "partials/pie.njk" %}
	</div>

	<script src="/js/funk.js"></script>
	<script src="/js/ui.js"></script>
</body>

</html>
