# Seguridad de la cadena de suministro:
# los paquetes NO pueden ejecutar código al instalarse (preinstall/postinstall),
# que es la vía habitual de los ataques a npm. Ninguna dependencia de este
# proyecto lo necesita (sólo fsevents, opcional y exclusivo de macOS).
ignore-scripts=true
# Guardar versiones exactas al añadir dependencias (nada de ^ ni ~)
save-exact=true
