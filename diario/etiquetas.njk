---
layout: layouts/base.njk
title: Etiquetas del diario
seccion: diario
permalink: /diario/etiquetas/
eleventyExcludeFromCollections: true
---
<h1 class="texto-centro">Etiquetas</h1>
<p class="texto-centro"><a href="/diario/">← Diario</a></p>

{% for etiqueta in collections.etiquetasDiario %}
<section class="grupo-etiqueta" id="{{ etiqueta | slugify }}">
	<h2>{{ etiqueta }}</h2>
	<ul>
		{%- for entrada in collections[etiqueta] | reverse %}
		<li><time datetime="{{ entrada.date | fechaISO }}">{{ entrada.date | fecha }}</time> <a href="{{ entrada.url }}">{{ entrada.data.title }}</a></li>
		{%- endfor %}
	</ul>
</section>
{% else %}
<p class="texto-centro">Todavía no hay etiquetas.</p>
{% endfor %}
