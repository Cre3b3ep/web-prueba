---
layout: layouts/base.njk
title: Diario
seccion: diario
descripcion: Diario de aprendizaje de jBaton
permalink: /diario/
eleventyExcludeFromCollections: true
---
{%- set entradas = (collections.diario or []) | reverse %}
<h1 class="texto-centro">Diario</h1>
<p class="texto-centro"><a href="/diario/etiquetas/">Etiquetas</a></p>

{% if entradas.length %}
<ol class="lista-entradas" reversed>
	{%- for entrada in entradas %}
	<li>
		<time datetime="{{ entrada.date | fechaISO }}">{{ entrada.date | fecha }}</time>
		<a href="{{ entrada.url }}">{{ entrada.data.title }}</a>
		<span class="autor autor-{{ entrada.data.autor | slugify }}">{{ entrada.data.autor }}</span>
		{%- for t in entrada.data.tags | etiquetasVisibles %} <span class="chip">{{ t }}</span>{% endfor %}
	</li>
	{%- endfor %}
</ol>
{% else %}
<p class="texto-centro">Todavía no hay entradas.</p>
{% endif %}
